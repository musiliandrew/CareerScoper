{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "careerscope",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "careerscope.me", "custom_domain": true },
    { "pattern": "www.careerscope.me", "custom_domain": true }
  ],
  "vars": {
    "ENVIRONMENT": "PROD",
    "NEXT_PUBLIC_ENVIRONMENT": "PROD",
    "NEXT_PUBLIC_API_URL": "https://careerscope-backend-786345663105.us-central1.run.app",
    "NEXT_PUBLIC_DJANGO_API_URL": "https://careerscope-backend-786345663105.us-central1.run.app/api",
    "NEXT_PUBLIC_INGESTION_URL": "https://careerscope-ingestion-786345663105.us-central1.run.app",
    "NEXT_PUBLIC_AI_ENRICHMENT_URL": "https://careerscope-ai-enrichment-786345663105.us-central1.run.app",
    "NEXT_PUBLIC_DECISION_ENGINE_URL": "https://careerscope-decision-engine-786345663105.us-central1.run.app",
    "NEXT_PUBLIC_PERSONALIZATION_URL": "https://careerscope-personalization-786345663105.us-central1.run.app",
    "NEXT_PUBLIC_EMAIL_INTELLIGENCE_URL": "https://careerscope-email-intelligence-786345663105.us-central1.run.app",
    "NEXT_PUBLIC_GEOAPIFY_API_KEY": "5c90e318144e439187050c853720e848",
    "GEMINI_FLASH_MODEL": "gemini-2.5-flash"
  }
}
